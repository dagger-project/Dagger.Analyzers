# Shared analyzer options for Dagger.Analyzers.
# global_level 0 overrides the SDK configs (they use -99) and loses to a repo
# .editorconfig or a .globalconfig left at the default level.
# Style options live here because a packaged .editorconfig glob does not cover
# source files outside the package. Dagger.Analyzers.editorconfig repeats them
# for `dotnet format` once that file sits in the repo.
is_global = true
global_level = 0

# ---- Layout and simplification --------------------------------------------------------
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_prefer_braces = true:warning
csharp_prefer_simple_using_statement = true:suggestion

csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = false:silent
csharp_style_expression_bodied_operators = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_indexers = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion
csharp_style_expression_bodied_local_functions = when_on_single_line:suggestion

csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_prefer_pattern_matching = true:warning
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_prefer_not_pattern = true:warning
csharp_style_prefer_extended_property_pattern = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_prefer_null_check_over_type_check = true:suggestion
csharp_style_unused_value_discard_variable_preference = true:suggestion

csharp_prefer_static_local_function = true:warning
csharp_prefer_static_anonymous_function = true:warning
csharp_style_prefer_readonly_struct = true:warning
csharp_style_prefer_readonly_struct_member = true:warning
dotnet_style_readonly_field = true:warning

dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_null_propagation = true:warning
dotnet_style_coalesce_expression = true:warning
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning
dotnet_style_prefer_simplified_boolean_expressions = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:suggestion
dotnet_style_prefer_conditional_expression_over_return = true:suggestion
dotnet_style_explicit_tuple_names = true:suggestion
dotnet_style_namespace_match_folder = false
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion

csharp_style_prefer_method_group_conversion = true:suggestion
csharp_style_prefer_top_level_statements = false:silent
csharp_style_prefer_utf8_string_literals = true:suggestion

# Naming: private fields _camel, private static fields s_camel,
# constants and private static readonly fields PascalCase.
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers =
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

dotnet_naming_rule.private_static_readonly.severity = warning
dotnet_naming_rule.private_static_readonly.symbols = private_static_readonly_fields
dotnet_naming_rule.private_static_readonly.style = pascal
dotnet_naming_symbols.private_static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly_fields.required_modifiers = static, readonly

dotnet_naming_rule.constants_pascal.severity = warning
dotnet_naming_rule.constants_pascal.symbols = constants
dotnet_naming_rule.constants_pascal.style = pascal
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_rule.private_static_s.severity = warning
dotnet_naming_rule.private_static_s.symbols = private_static_fields
dotnet_naming_rule.private_static_s.style = s_camel
dotnet_naming_symbols.private_static_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_fields.required_modifiers = static
dotnet_naming_style.s_camel.capitalization = camel_case
dotnet_naming_style.s_camel.required_prefix = s_

dotnet_naming_rule.private_static_readonly.priority = 1
dotnet_naming_rule.constants_pascal.priority = 1
dotnet_naming_rule.private_static_s.priority = 2
dotnet_naming_rule.private_fields_underscore.priority = 3

# SDK recommended style turns every IDE rule into a warning. Keep the useful
# ones and drop the ones that fight this style.
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0007.severity = suggestion
dotnet_diagnostic.IDE0008.severity = suggestion
dotnet_diagnostic.IDE0011.severity = warning
dotnet_diagnostic.IDE0022.severity = suggestion
dotnet_diagnostic.IDE0036.severity = warning
dotnet_diagnostic.IDE0040.severity = warning
dotnet_diagnostic.IDE0044.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0055.severity = none
dotnet_diagnostic.IDE0059.severity = warning
dotnet_diagnostic.IDE0060.severity = warning
dotnet_diagnostic.IDE0073.severity = none
dotnet_diagnostic.IDE0130.severity = none
dotnet_diagnostic.IDE0160.severity = none
dotnet_diagnostic.IDE0161.severity = warning
dotnet_diagnostic.IDE0290.severity = suggestion
dotnet_diagnostic.IDE1006.severity = warning

# ---- Async naming and threading -------------------------------------------------------
# VSTHRD200 is the async suffix rule (and the inverse: sync methods must not end in Async).
dotnet_diagnostic.VSTHRD200.severity = warning
dotnet_diagnostic.RCS1046.severity = none
dotnet_diagnostic.RCS1047.severity = none

dotnet_diagnostic.VSTHRD002.severity = warning
dotnet_diagnostic.VSTHRD003.severity = warning
dotnet_diagnostic.VSTHRD100.severity = warning
dotnet_diagnostic.VSTHRD101.severity = warning
dotnet_diagnostic.VSTHRD102.severity = warning
dotnet_diagnostic.VSTHRD103.severity = warning
dotnet_diagnostic.VSTHRD105.severity = warning
dotnet_diagnostic.VSTHRD110.severity = warning
dotnet_diagnostic.VSTHRD112.severity = warning
dotnet_diagnostic.VSTHRD113.severity = warning
dotnet_diagnostic.VSTHRD114.severity = warning
dotnet_diagnostic.VSTHRD104.severity = suggestion
# ConfigureAwait(false) is a library concern. Applications on modern .NET should not be forced into it.
dotnet_diagnostic.VSTHRD111.severity = silent
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.MA0004.severity = none

# JoinableTask / main-thread rules apply to Visual Studio extensions, not general C#.
dotnet_diagnostic.VSTHRD001.severity = none
dotnet_diagnostic.VSTHRD004.severity = none
dotnet_diagnostic.VSTHRD010.severity = none
dotnet_diagnostic.VSTHRD011.severity = none
dotnet_diagnostic.VSTHRD012.severity = none

# ---- Pattern matching -----------------------------------------------------------------
# IDE0019 / IDE0078 / IDE0083 carry the code fix. Roslynator reports the same issue.
dotnet_diagnostic.RCS1220.severity = none
dotnet_diagnostic.RCS1221.severity = none
dotnet_diagnostic.IDE0019.severity = warning
dotnet_diagnostic.IDE0020.severity = warning
dotnet_diagnostic.IDE0078.severity = warning
dotnet_diagnostic.IDE0083.severity = suggestion

# ---- Records --------------------------------------------------------------------------
# init and get-only members stay valid. set, including private set, does not.
dotnet_diagnostic.DAG0001.severity = warning

# ---- Complexity -----------------------------------------------------------------------
# CA1502's threshold is CodeMetricsConfig.txt (CA1502: 20), not an editorconfig key.
dotnet_diagnostic.CA1502.severity = warning
dotnet_diagnostic.CA1501.severity = suggestion
dotnet_diagnostic.CA1505.severity = suggestion
dotnet_diagnostic.CA1506.severity = suggestion
dotnet_diagnostic.RCS1208.severity = warning
dotnet_diagnostic.MA0051.severity = suggestion

# ---- Performance (high signal, still simple) ------------------------------------------
dotnet_diagnostic.CA1826.severity = warning
dotnet_diagnostic.CA1827.severity = warning
dotnet_diagnostic.CA1828.severity = warning
dotnet_diagnostic.CA1829.severity = warning
dotnet_diagnostic.CA1836.severity = warning
dotnet_diagnostic.CA1860.severity = warning
dotnet_diagnostic.CA1861.severity = warning
dotnet_diagnostic.CA1869.severity = warning
dotnet_diagnostic.CA1849.severity = warning
dotnet_diagnostic.CA2016.severity = warning
dotnet_diagnostic.CA2012.severity = warning
dotnet_diagnostic.CA2024.severity = warning
dotnet_diagnostic.RCS1198.severity = warning
dotnet_diagnostic.RCS1080.severity = none
dotnet_diagnostic.RCS1077.severity = suggestion

# ---- Correctness already covered elsewhere, or too noisy for every project ------------
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1303.severity = none
dotnet_diagnostic.CA1848.severity = suggestion
dotnet_diagnostic.RCS1138.severity = none
dotnet_diagnostic.RCS1139.severity = none
dotnet_diagnostic.RCS1194.severity = none
dotnet_diagnostic.RS0030.severity = warning

# Whitespace belongs to the formatter (`dotnet format`), not the build.
dotnet_diagnostic.IDE0055.severity = none
